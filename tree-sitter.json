{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "python_orchard",
      "camelcase": "PythonOrchard",
      "title": "Python",
      "scope": "source.python",
      "file-types": [
        "py"
      ],
      "injection-regex": "^python_orchard$",
      "class-name": "TreeSitterPythonOrchard"
    }
  ],
  "metadata": {
    "version": "0.6.0",
    "license": "MIT",
    "description": "Parser for Python files",
    "authors": [
      {
        "name": "Max Brunsfeld",
        "email": "maxbrunsfeld@gmail.com"
      },
      {
        "name": "Amaan Qureshi",
        "email": "amaanq12@gmail.com"
      }
    ],
    "links": {
      "repository": "https://codeberg.org/grammar-orchard/tree-sitter-python-orchard",
      "upstream": "https://github.com/tree-sitter/tree-sitter-python",
      "github_mirror": "https://github.com/grammar-orchard/tree-sitter-python-orchard"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
